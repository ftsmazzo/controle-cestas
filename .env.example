# Obrigatório no EasyPanel (serviço App)
DATABASE_URL=postgresql://usuario:senha@nome-servico-postgres:5432/controle_cestas

# Porta HTTP exposta pelo container (EasyPanel: use 80)
PORT=80

# Produção
NODE_ENV=production

# Opcional: SSL no Postgres (alguns provedores externos)
# PGSSLMODE=require

# Área administrativa — protege importar/alterar/zerar (recomendado em produção)
# ADMIN_API_KEY=uma-chave-longa-e-secreta
# ADMIN_PATH=/admin

# Build do frontend (opcional, deve coincidir com ADMIN_PATH)
# VITE_ADMIN_PATH=/admin
